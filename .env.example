# MediGuide AI environment template
# Copy this file to .env and add your own values.
# Never put a real API key in this example file.

# Required for live AI assessments.
# A ChatGPT Plus/Pro subscription does NOT automatically include API credits.
OPENAI_API_KEY=ur_api_key 
# Chat model name. gpt-4o-mini is a common inexpensive example.
# Your OpenAI account must actually have access to the model you enter.
OPENAI_MODEL=gpt-4o-mini

# Optional persistent assessment history (SQLite). Default is off for privacy.
ENABLE_ASSESSMENT_HISTORY=false

# Optional LangChain LLM cache. Default is off because cached entries
# can contain patient prompts and model responses.
ENABLE_LLM_CACHE=false

# Model request timeout in seconds.
OPENAI_TIMEOUT_SECONDS=60

# Lower temperature keeps educational answers more consistent.
OPENAI_TEMPERATURE=0.2

# Only set this if you have verified the local emergency number yourself.
# Leave blank to avoid showing an unverified number.
LOCAL_EMERGENCY_NUMBER=
