# MediGuide AI - files that should never be committed

# Secret environment values (API keys, passwords)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Test and tool cache
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local databases and generated files
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Streamlit / editor
.streamlit/secrets.toml
.idea/
.vscode/
